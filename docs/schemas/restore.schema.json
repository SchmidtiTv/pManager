{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "restore.schema.json",
  "description": "stdout of `pman project restore <PATH> -o json`: exactly one object describing the restored project.",
  "type": "array",
  "minItems": 1,
  "maxItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "state": { "const": "registered" },
      "path": { "type": "string", "minLength": 1 }
    },
    "required": ["name", "state", "path"],
    "additionalProperties": false
  }
}
