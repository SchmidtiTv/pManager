{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "description": "stdout of `pman project status <PATH> -o json`: exactly one object, measured live like `pman run`. Dates are local calendar dates.",
  "type": "array",
  "minItems": 1,
  "maxItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "state": { "enum": ["registered", "stripped", "archived"] },
      "last_change_at": { "type": "string", "format": "date" },
      "idle": { "type": "integer", "description": "Whole days since last_change_at." },
      "dirty": {
        "type": ["boolean", "null"],
        "description": "Uncommitted git changes; null when the folder is not on disk."
      },
      "next_action": { "enum": ["strip", "archive", "strip+archive", "none"] },
      "next_action_at": {
        "type": ["string", "null"],
        "format": "date",
        "description": "Today when already due; null when next_action is none."
      },
      "reason": {
        "enum": ["active", "no profile", "already archived", "missing", null],
        "description": "Why there is no next action; null when there is one."
      },
      "path": { "type": "string", "minLength": 1 }
    },
    "required": [
      "name",
      "state",
      "last_change_at",
      "idle",
      "dirty",
      "next_action",
      "next_action_at",
      "reason",
      "path"
    ],
    "additionalProperties": false
  }
}
